<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PunchOut Simulator — Send Setup Request</title>
    <style>
        body { font-family: monospace; max-width: 800px; margin: 2rem auto; padding: 0 1rem; }
        h1 { color: #333; }
        .form-group { margin-bottom: 1rem; }
        label { display: block; font-weight: bold; margin-bottom: 0.25rem; }
        input, select { width: 100%; padding: 0.5rem; box-sizing: border-box; font-family: monospace; }
        button { padding: 0.75rem 2rem; background: #007cba; color: white; border: none; cursor: pointer; font-size: 1rem; }
        pre { background: #f5f5f5; padding: 1rem; overflow: auto; font-size: 0.8rem; max-height: 400px; }
        .success { color: green; font-weight: bold; }
        .error { color: red; font-weight: bold; }
        .start-link { background: #e0ffe0; padding: 1rem; margin: 1rem 0; border-left: 4px solid green; }
        .warning { background: #fff3cd; padding: 0.5rem; border: 1px solid #ffc107; margin-bottom: 1rem; }
    </style>
</head>
<body>

<h1>🛒 PunchOut cXML Simulator</h1>
<p class="warning">⚠️ This simulator is <strong>test application only</strong> — never available in production.</p>

{% if error %}
    <p class="error">Error: {{ error }}</p>
{% endif %}

{% if startUrl %}
    <div class="start-link">
        <p class="success">✅ Setup request accepted.</p>
        <p>Start URL: <a href="{{ startUrl }}" target="_blank">{{ startUrl }}</a></p>
        <p><a href="{{ startUrl }}">Click here to enter the shop as a PunchOut buyer →</a></p>
    </div>
{% endif %}

{% if result %}
    <h2>Server Response</h2>
    <pre>{{ result }}</pre>
{% endif %}

<hr>
<form method="post" action="/simulator/cxml">
    <h2>PunchOut Setup Request</h2>

    <div class="form-group">
        <label>From Domain</label>
        <input type="text" name="from_domain" value="AribaNetworkUserId">
    </div>
    <div class="form-group">
        <label>From Identity (buyer organization)</label>
        <input type="text" name="from_identity" value="demo-buyer@example.com">
    </div>
    <div class="form-group">
        <label>Sender Domain</label>
        <input type="text" name="sender_domain" value="AribaNetworkUserId">
    </div>
    <div class="form-group">
        <label>Sender Identity (procurement system)</label>
        <input type="text" name="sender_identity" value="demo-system@example.com">
    </div>
    <div class="form-group">
        <label>Shared Secret</label>
        <input type="text" name="shared_secret" value="" placeholder="Paste the secret from the demo fixture output">
    </div>
    <div class="form-group">
        <label>Supplier Domain</label>
        <input type="text" name="supplier_domain" value="NetworkId">
    </div>
    <div class="form-group">
        <label>Supplier Identity</label>
        <input type="text" name="supplier_identity" value="demo-supplier@example.com">
    </div>
    <div class="form-group">
        <label>Operation</label>
        <select name="operation">
            <option value="create">create</option>
            <option value="edit">edit</option>
            <option value="inspect">inspect</option>
        </select>
    </div>

    <button type="submit">Send PunchOutSetupRequest →</button>
</form>

</body>
</html>
