{% set form = hookable_metadata.context.form %}

<div class="row">
    <div class="col-12 col-md-4">{{ form_row(form.code) }}</div>
    <div class="col-12 col-md-6">{{ form_row(form.name) }}</div>
    <div class="col-12 col-md-2 pt-md-4">{{ form_row(form.enabled) }}</div>
</div>
<div class="row">
    <div class="col-12 col-md-4">{{ form_row(form.protocol) }}</div>
    <div class="col-12 col-md-4">{{ form_row(form.channel) }}</div>
    <div class="col-12 col-md-4">{{ form_row(form.customer) }}</div>
</div>
<h4 class="mt-3">{{ 'tmonier_punchout.form.buyer.identities'|trans }}</h4>
<p class="text-secondary small">{{ 'tmonier_punchout.form.buyer.identities_help'|trans }}</p>
<div class="row">
    <div class="col-12 col-md-3">{{ form_row(form.fromDomain) }}</div>
    <div class="col-12 col-md-3">{{ form_row(form.fromIdentity) }}</div>
    <div class="col-12 col-md-3">{{ form_row(form.senderDomain) }}</div>
    <div class="col-12 col-md-3">{{ form_row(form.senderIdentity) }}</div>
</div>
{{ form_row(form.returnDomains) }}
