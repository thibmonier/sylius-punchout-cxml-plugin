{% set form = hookable_metadata.context.form %}

<div class="row">
    <div class="col-12 col-md-4">{{ form_row(form.code) }}</div>
    <div class="col-12 col-md-6">{{ form_row(form.name) }}</div>
    <div class="col-12 col-md-2 pt-md-4">{{ form_row(form.enabled) }}</div>
</div>
<div class="row">
    <div class="col-12 col-md-4">{{ form_row(form.protocol) }}</div>
    <div class="col-12 col-md-4">{{ form_row(form.channel) }}</div>
    <div class="col-12 col-md-4">{{ form_row(form.customer) }}</div>
</div>
<div class="row">
    <div class="col-12 col-md-4">{{ form_row(form.ociUsername) }}</div>
    {% if form.companyId is defined %}
        <div class="col-12 col-md-4">{{ form_row(form.companyId) }}</div>
    {% endif %}
</div>
<h4 class="mt-3">{{ 'tmonier_punchout.form.buyer.identities'|trans }}</h4>
<div class="row">
    <div class="col-12 col-md-6">{{ form_row(form.fromIdentities) }}</div>
    <div class="col-12 col-md-6">{{ form_row(form.senderIdentities) }}</div>
</div>
<div class="row">
    <div class="col-12 col-md-6">{{ form_row(form.returnDomains) }}</div>
    <div class="col-12 col-md-6">{{ form_row(form.iframeOrigins) }}</div>
</div>
<div class="row">
    <div class="col-12 col-md-6">{{ form_row(form.defaultUnit) }}</div>
    <div class="col-12 col-md-6">{{ form_row(form.defaultUnspsc) }}</div>
</div>
<div class="row">
    <div class="col-12 col-md-6">{{ form_row(form.includeTax) }}</div>
    <div class="col-12 col-md-6">{{ form_row(form.includeShipping) }}</div>
</div>
