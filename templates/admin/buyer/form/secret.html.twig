{% set buyer = hookable_metadata.context.resource %}
{% set secrets = app.flashes('tmonier_punchout_secret') %}

{% if secrets is not empty %}
    <div class="alert alert-warning" {{ sylius_test_html_attribute('tmonier-punchout-secret') }}>
        <div class="fw-bold">{{ 'tmonier_punchout.ui.secret.title'|trans }}</div>
        <p class="mb-1">{{ 'tmonier_punchout.ui.secret.help'|trans }}</p>
        <code class="fs-5 user-select-all" {{ sylius_test_html_attribute('tmonier-punchout-secret-value') }}>{{ secrets|first }}</code>
    </div>
{% endif %}

<div class="card mb-3">
    <div class="card-body">
        <h4 class="card-title">{{ 'tmonier_punchout.ui.secret.section'|trans }}</h4>
        <p class="text-secondary small">{{ 'tmonier_punchout.ui.secret.rotation_help'|trans }}</p>
        <ul class="list-unstyled mb-3">
            {% for credential in buyer.activeCredentials %}
                <li class="d-flex align-items-center gap-3 mb-1">
                    <span>{{ 'tmonier_punchout.ui.secret.created'|trans({'%date%': credential.createdAt|date('Y-m-d H:i')}) }}</span>
                    <button type="submit" form="tmonier-punchout-revoke-secret-{{ credential.id }}" class="btn btn-sm btn-outline-danger">{{ 'tmonier_punchout.ui.secret.revoke'|trans }}</button>
                </li>
            {% else %}
                <li class="text-danger">{{ 'tmonier_punchout.ui.secret.none'|trans }}</li>
            {% endfor %}
        </ul>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="submit" form="tmonier-punchout-regenerate-secret" class="btn btn-sm btn-outline-primary" {{ sylius_test_html_attribute('tmonier-punchout-regenerate-secret') }}>{{ 'tmonier_punchout.ui.secret.regenerate'|trans }}</button>
            <span class="text-secondary small">{{ 'tmonier_punchout.ui.secret.or'|trans }}</span>
            <input type="password" name="secret" form="tmonier-punchout-set-secret" autocomplete="new-password" minlength="16" class="form-control form-control-sm w-auto" placeholder="{{ 'tmonier_punchout.ui.secret.set_placeholder'|trans }}">
            <button type="submit" form="tmonier-punchout-set-secret" class="btn btn-sm btn-outline-primary">{{ 'tmonier_punchout.ui.secret.set'|trans }}</button>
        </div>
    </div>
</div>
