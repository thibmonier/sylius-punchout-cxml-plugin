{% set buyer = hookable_metadata.context.resource %}
{% set secrets = app.flashes('tmonier_punchout_secret') %}

{% if secrets is not empty %}
    <div class="alert alert-warning" {{ sylius_test_html_attribute('tmonier-punchout-secret') }}>
        <div class="fw-bold">{{ 'tmonier_punchout.ui.secret.title'|trans }}</div>
        <p class="mb-1">{{ 'tmonier_punchout.ui.secret.help'|trans }}</p>
        <code class="fs-5 user-select-all" {{ sylius_test_html_attribute('tmonier-punchout-secret-value') }}>{{ secrets|first }}</code>
    </div>
{% endif %}

<div class="mb-3 d-flex align-items-center gap-3">
    <span class="text-secondary small">{{ 'tmonier_punchout.ui.secret.active'|trans({'%count%': buyer.activeCredentials|length}) }}</span>
    <button type="submit" form="tmonier-punchout-regenerate-secret" class="btn btn-sm btn-outline-danger" {{ sylius_test_html_attribute('tmonier-punchout-regenerate-secret') }}>{{ 'tmonier_punchout.ui.secret.regenerate'|trans }}</button>
</div>
