{# Outside the edit form (no nested form): targets of the secret buttons of form/secret.html.twig. #}
{% set buyer = hookable_metadata.context.resource %}
{% set token = csrf_token('tmonier_punchout_secret' ~ buyer.id) %}

<form id="tmonier-punchout-regenerate-secret" method="post" action="{{ path('tmonier_punchout_admin_buyer_regenerate_secret', {id: buyer.id}) }}">
    <input type="hidden" name="_csrf_token" value="{{ token }}">
</form>
<form id="tmonier-punchout-set-secret" method="post" action="{{ path('tmonier_punchout_admin_buyer_set_secret', {id: buyer.id}) }}">
    <input type="hidden" name="_csrf_token" value="{{ token }}">
</form>
{% for credential in buyer.activeCredentials %}
    <form id="tmonier-punchout-revoke-secret-{{ credential.id }}" method="post" action="{{ path('tmonier_punchout_admin_buyer_revoke_secret', {id: buyer.id, credentialId: credential.id}) }}" {{ sylius_test_html_attribute('tmonier-punchout-revoke-secret') }}>
        <input type="hidden" name="_csrf_token" value="{{ token }}">
    </form>
{% endfor %}
