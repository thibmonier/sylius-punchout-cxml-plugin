<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Tmonier\SyliusPunchoutCxmlPlugin\Order\ReceivedPurchaseOrder" table="tmonier_punchout_order_request">
        <unique-constraints>
            <unique-constraint name="uniq_punchout_order_request_po" columns="buyer_id,purchase_order"/>
        </unique-constraints>

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="purchaseOrder" type="string" length="100" nullable="false" column="purchase_order"/>
        <field name="payloadId" type="string" length="255" nullable="false" column="payload_id"/>
        <field name="createdAt" type="datetime_immutable" nullable="false" column="created_at"/>

        <many-to-one field="buyer" target-entity="Tmonier\SyliusPunchoutCxmlPlugin\Buyer\Buyer">
            <join-column name="buyer_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-one field="order" target-entity="Sylius\Component\Core\Model\Order">
            <join-column name="order_id" referenced-column-name="id" nullable="true" on-delete="SET NULL"/>
        </many-to-one>
    </entity>

</doctrine-mapping>
