<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Tmonier\SyliusPunchoutCxmlPlugin\Buyer\Buyer"
            table="tmonier_punchout_buyer">

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="name" type="string" length="255" nullable="false"/>
        <field name="protocol" type="string" length="10" nullable="false"/>
        <field name="enabled" type="boolean" nullable="false"/>
        <field name="allowedReturnDomains" type="json" nullable="false" column="allowed_return_domains"/>
        <field name="channelCode" type="string" length="255" nullable="true" column="channel_code"/>
        <field name="notes" type="text" nullable="true"/>
        <field name="createdAt" type="datetime_immutable" nullable="false" column="created_at"/>
        <field name="updatedAt" type="datetime_immutable" nullable="false" column="updated_at"/>

        <one-to-many field="identities"
                     target-entity="Tmonier\SyliusPunchoutCxmlPlugin\Buyer\BuyerIdentity"
                     mapped-by="buyer"
                     orphan-removal="true">
            <cascade><cascade-all/></cascade>
        </one-to-many>

        <one-to-many field="credentials"
                     target-entity="Tmonier\SyliusPunchoutCxmlPlugin\Buyer\BuyerCredential"
                     mapped-by="buyer"
                     orphan-removal="true">
            <cascade><cascade-all/></cascade>
            <order-by>
                <order-by-field name="createdAt" direction="DESC"/>
            </order-by>
        </one-to-many>

    </entity>

</doctrine-mapping>
