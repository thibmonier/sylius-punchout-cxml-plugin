<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Tmonier\SyliusPunchoutCxmlPlugin\Buyer\BuyerCredential"
            table="tmonier_punchout_buyer_credential">

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="passwordHash" type="string" length="255" nullable="false" column="password_hash"/>
        <field name="createdAt" type="datetime_immutable" nullable="false" column="created_at"/>
        <field name="revokedAt" type="datetime_immutable" nullable="true" column="revoked_at"/>

        <many-to-one field="buyer"
                     target-entity="Tmonier\SyliusPunchoutCxmlPlugin\Buyer\Buyer"
                     inversed-by="credentials">
            <join-column name="buyer_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

    </entity>

</doctrine-mapping>
