<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Tmonier\SyliusPunchoutCxmlPlugin\Buyer\Buyer"
            table="tmonier_punchout_buyer">

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="code" type="string" length="255" nullable="false" unique="true"/>
        <field name="name" type="string" length="255" nullable="false"/>
        <field name="protocol" type="string" length="10" nullable="false"/>
        <field name="enabled" type="boolean" nullable="false"/>
        <field name="ociUsername" type="string" length="255" nullable="true" column="oci_username"/>
        <field name="companyId" type="string" length="255" nullable="true" column="company_id"/>
        <field name="returnDomains" type="json" nullable="false" column="return_domains"/>
        <field name="iframeOrigins" type="json" nullable="false" column="iframe_origins"/>
        <field name="locale" type="string" length="20" nullable="true"/>
        <field name="includeShipping" type="boolean" nullable="true" column="include_shipping"/>
        <field name="defaultUnit" type="string" length="8" nullable="false" column="default_unit">
            <options><option name="default">EA</option></options>
        </field>
        <field name="orderPaymentMethod" type="string" length="255" nullable="true" column="order_payment_method"/>
        <field name="orderShippingMethod" type="string" length="255" nullable="true" column="order_shipping_method"/>
        <field name="defaultUnspsc" type="string" length="16" nullable="true" column="default_unspsc"/>
        <field name="includeTax" type="boolean" nullable="false" column="include_tax">
            <options><option name="default">0</option></options>
        </field>

        <many-to-one field="customer"
                     target-entity="Sylius\Component\Core\Model\Customer">
            <join-column name="customer_id" referenced-column-name="id" nullable="true" on-delete="SET NULL"/>
        </many-to-one>

        <many-to-one field="channel"
                     target-entity="Sylius\Component\Core\Model\Channel">
            <join-column name="channel_id" referenced-column-name="id" nullable="true" on-delete="SET NULL"/>
        </many-to-one>

        <one-to-many field="identities"
                     target-entity="Tmonier\SyliusPunchoutCxmlPlugin\Buyer\BuyerIdentity"
                     mapped-by="buyer"
                     orphan-removal="true">
            <cascade><cascade-all/></cascade>
        </one-to-many>

        <one-to-many field="credentials"
                     target-entity="Tmonier\SyliusPunchoutCxmlPlugin\Buyer\BuyerCredential"
                     mapped-by="buyer"
                     orphan-removal="true">
            <cascade><cascade-all/></cascade>
            <order-by>
                <order-by-field name="id" direction="ASC"/>
            </order-by>
        </one-to-many>

        <unique-constraints>
            <unique-constraint columns="code" name="uniq_punchout_buyer_code"/>
        </unique-constraints>

    </entity>

</doctrine-mapping>
